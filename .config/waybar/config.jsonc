// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",

    // FIXED: the old config hardcoded "width": 1900, which only lines up on a
    // 1920px-wide screen. On anything else the bar was visibly off-centre or
    // overflowed. Omitting width lets waybar span the output; use margins to
    // inset it instead.
    "margin-top": 4,
    "margin-left": 10,
    "margin-right": 10,

    "spacing": 2,

    "modules-left": [
        "custom/arch",
        //"custom/search",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "power-profiles-daemon",
        "custom/cava_mviz",
        "mpris",
        "hyprland/window"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "backlight",
        "network#speed",
        "network",
        "bluetooth",
        "hyprland/language",
        "tray",
        // NOTE: custom/swaync needs swaync running. conf/autostart.lua starts
        // dunst instead. Pick one — either switch M.notifier to "swaync" in
        // conf/programs.lua, or remove this module. Left in place to preserve
        // the original layout.
        "custom/swaync",
        "clock",
        "custom/power"
    ],

    "include": [
        "~/.config/waybar/modules.json"
    ]
}
